POSTGRES_DB=beehome
POSTGRES_USER=beehome
POSTGRES_PASSWORD=beehome-local-only
POSTGRES_PORT=5432
APP_PORT=8080
# Local development only: a fresh signing key is generated on each application start.
AUTH_ALLOW_EPHEMERAL_KEY=true
AUTH_SIGNING_KEY=
AUTH_ISSUER=beehome
AUTH_ACCESS_TTL=15m
AUTH_REFRESH_TTL=30d
AUTH_RESET_TTL=30m
AUTH_RESET_COOLDOWN=5m
AUTH_REQUESTS_PER_MINUTE=30
AUTH_PUBLIC_DOCS=true

# Enable SMTP delivery and configure your provider and frontend reset page.
# No messages are delivered while this is false in local development.
AUTH_RESET_MAIL_ENABLED=false
AUTH_RESET_MAIL_FROM=
AUTH_RESET_URL=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS_ENABLED=true
MAIL_STARTTLS_REQUIRED=true
# For implicit TLS (usually port 465), enable SSL and disable both STARTTLS flags.
MAIL_SSL_ENABLED=false
